# Google Gemini API Key
# Used by the GeminiAPReasoner engine for LLM-based 3-way matching arbitration,
# contract clause interpretation, and autonomous vendor dispute generation.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Model (Default: gemini-3.8-flash)
# Supported current-generation models: gemini-3.8-flash, gemini-3.8-pro, gemini-3.5-flash, gemini-3.5-pro
# (Legacy models like 2.5 are deprecated)
GEMINI_MODEL=gemini-3.8-flash

# Server Port (Default: 8080)
PORT=8080
